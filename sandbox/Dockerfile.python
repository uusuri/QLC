ARG PYTHON_IMAGE=python:3.12-slim-trixie

FROM ${PYTHON_IMAGE} AS sandbox-build

RUN apt-get update \
  && apt-get install -y --no-install-recommends g++ cmake ninja-build \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /src/sandbox
COPY sandbox/CMakeLists.txt ./
COPY sandbox/include ./include
COPY sandbox/src ./src
RUN cmake -S . -B build -G Ninja -DCMAKE_BUILD_TYPE=Release \
  && cmake --build build

FROM ${PYTHON_IMAGE}
RUN apt-get update \
  && apt-get install -y --no-install-recommends time \
  && rm -rf /var/lib/apt/lists/* \
  && if ! command -v python3 >/dev/null 2>&1; then \
       ln -s "$(command -v pypy3)" /usr/local/bin/python3; \
     fi
COPY --from=sandbox-build /src/sandbox/build/sandbox /usr/local/bin/qlc-sandbox
COPY sandbox/runner.sh /usr/local/bin/qlc-runner
COPY sandbox/judge.py /usr/local/lib/qlc/judge.py
RUN chmod 0555 /usr/local/bin/qlc-runner \
  && chmod 0444 /usr/local/lib/qlc/judge.py \
  && mkdir -p /work
WORKDIR /work
ENTRYPOINT ["/usr/local/bin/qlc-runner"]
