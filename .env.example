# Copy to .env. Use one KEY=value per line without quotes or inline comments
# for the fish export command documented in backend/README.md.
POSTGRES_DB=qlc_database
POSTGRES_USER=qlc
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
REDIS_HOST=localhost
REDIS_PORT=6379
SPRING_LOCAL_PORT=8080
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Generate a private random key of at least 64 bytes; never commit the real value.
JWT_SECRET=
JWT_EXPIRATION=86400000
# Optional. An empty token disables Telegram login.
TELEGRAM_BOT_TOKEN=
